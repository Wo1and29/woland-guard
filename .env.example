# Только локальные демонстрационные значения. Не используйте их в production.
WG_APP_ENV=development
WG_HTTP_PORT=8000

WG_POSTGRES_HOST=localhost
WG_POSTGRES_PORT=5432
WG_POSTGRES_DB=woland_guard
WG_TEST_POSTGRES_DB=woland_guard_test
WG_POSTGRES_USER=woland_guard
WG_POSTGRES_PASSWORD=local-development-only
WG_POSTGRES_CONNECT_TIMEOUT_SECONDS=3

WG_INGEST_MAX_BODY_BYTES=1048576
WG_INGEST_RATE_LIMIT_REQUESTS=60
WG_INGEST_RATE_LIMIT_WINDOW_SECONDS=60
WG_INGEST_MAX_CLOCK_SKEW_SECONDS=300
WG_OPERATOR_SECURITY_LOG_EVENTS=10
WG_OPERATOR_SECURITY_LOG_WINDOW_SECONDS=60

WG_OUTBOX_POLL_SECONDS=2
WG_OUTBOX_LEASE_SECONDS=60
WG_OUTBOX_ADAPTER_TIMEOUT_SECONDS=30
WG_OUTBOX_RECOVERY_INTERVAL_SECONDS=30
WG_OUTBOX_BACKOFF_BASE_SECONDS=5
WG_OUTBOX_BACKOFF_MAX_SECONDS=900
WG_OUTBOX_RETRY_AFTER_CAP_SECONDS=3600
WG_OUTBOX_DEFAULT_MAX_ATTEMPTS=5
